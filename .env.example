# Copy to .env for local development. Replace every value in production.

# MySQL / Prisma
DATABASE_URL="mysql://ekatalog_user:local_dev_password@127.0.0.1:3307/e_katalog"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Public store settings (no secrets here)
# IMPORTANT: Must match BETTER_AUTH_URL for auth to work correctly
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Store WhatsApp number (NOT prefixed with NEXT_PUBLIC — server-only, not exposed to client)
STORE_WHATSAPP_NUMBER="6280000000000"

# Rate limiting (public POST endpoints)
# By default an in-memory fixed-window store is used — correct for a single
# Node process (`next start`). For multi-instance / serverless deployments,
# Redis (e.g. Upstash) is RECOMMENDED so limits are shared across instances;
# implement the RateLimitStore seam in src/lib/ratelimit.ts.
# Set to "true" to bypass rate limiting entirely (local dev / integration tests).
RATE_LIMIT_DISABLED="false"
