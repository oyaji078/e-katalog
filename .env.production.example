# =============================================================================
# Production environment — Hostinger Business (Node.js website)
# =============================================================================
# Copy these into hPanel -> Websites -> ramacomputer.id -> Node.js -> Environment
# variables. Do NOT commit the filled-in version: .gitignore already excludes
# every .env* except the *.example files.
#
# IMPORTANT: set all of these BEFORE the first build. Next.js inlines every
# NEXT_PUBLIC_* value into the bundle at build time, so changing one later
# requires a full redeploy, not just a restart.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Create in hPanel -> Databases -> MySQL. Hostinger prefixes the database and
# user names (e.g. u123456789_ekatalog). Host stays localhost when the app and
# the database live on the same hosting account.
# URL-encode any character in the password that is reserved in a URI
# (@ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F).
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# --- Better Auth --------------------------------------------------------------
# 32 random bytes. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never reuse the development secret. Rotating this invalidates all sessions.
BETTER_AUTH_SECRET="replace-with-a-fresh-32-byte-secret"

# Must be the exact public origin, https, no trailing slash. better-auth checks
# the request origin against this — a mismatch rejects every sign-in with 403.
BETTER_AUTH_URL="https://ramacomputer.id"

# --- Public app URL -----------------------------------------------------------
# Must match BETTER_AUTH_URL exactly. Also used as metadataBase for SEO tags.
NEXT_PUBLIC_APP_URL="https://ramacomputer.id"

# --- Store settings -----------------------------------------------------------
# Server-only (not prefixed with NEXT_PUBLIC). Format: country code + number,
# no +, no spaces, no leading zero.
STORE_WHATSAPP_NUMBER="6287750008403"

# --- Rate limiting ------------------------------------------------------------
# Keep "false" in production. Shared hosting runs a single Node process, so the
# built-in in-memory fixed-window limiter is correct here; Redis is only needed
# for multi-instance deployments.
RATE_LIMIT_DISABLED="false"

# --- Redis (optional, leave unset on shared hosting) --------------------------
# Hostinger shared hosting does not provide Redis. Leaving REDIS_URL unset makes
# src/lib/ratelimit.ts fall back to the in-memory store, which is the intended
# behaviour for a single process. /admin system health will report Redis as WARN.
# REDIS_URL=""
