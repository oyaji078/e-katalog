{
  "name": "e-katalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-demo": "tsx prisma/seed-demo.ts",
    "prisma:studio": "prisma studio",
    "test:e2e": "playwright test",
    "load:baseline": "k6 run --out json=results/baseline.json scripts/load-test/baseline.js",
    "load:peak": "k6 run --out json=results/peak.json scripts/load-test/peak.js",
    "load:stress": "k6 run --out json=results/stress.json scripts/load-test/stress.js",
    "load:spike": "k6 run --out json=results/spike.json scripts/load-test/spike.js",
    "load:soak": "k6 run --out json=results/soak.json scripts/load-test/soak.js",
    "load:api": "k6 run --out json=results/api-contract.json scripts/load-test/api-contract.js",
    "load:all": "npm run load:baseline && npm run load:api"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.11",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.11",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.16.0",
    "mariadb": "^3.5.2",
    "next": "16.2.6",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "puppeteer-core": "^25.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
